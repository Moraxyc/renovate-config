{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:best-practices",
        ":separateMultipleMajorReleases",
        "schedule:weekly"
    ],
    "automergeType": "pr",
    "platformAutomerge": true,
    "ignoreTests": false,
    "internalChecksFilter": "strict",
    "dependencyDashboardAutoclose": true,
    "prConcurrentLimit": 5,
    "major": {
        "dependencyDashboardApproval": true,
        "automerge": false
    },
    "lockFileMaintenance": {
        "enabled": true,
        "automerge": true,
        "automergeType": "pr"
    },
    "nix": {
        "enabled": true
    },
    "vulnerabilityAlerts": {
        "enabled": true,
        "addLabels": [
            "security"
        ],
        "automerge": false
    },
    "packageRules": [
        {
            "description": "Automerge stable non-major updates after 7 days",
            "matchUpdateTypes": [
                "minor",
                "patch"
            ],
            "matchCurrentVersion": "!/^0/",
            "minimumReleaseAge": "7 days",
            "minimumReleaseAgeBehaviour": "timestamp-optional",
            "automerge": true,
            "automergeType": "pr"
        },
        {
            "description": "Group patch, pin and digest updates into one PR",
            "matchUpdateTypes": [
                "patch",
                "pin",
                "pinDigest",
                "digest"
            ],
            "groupName": "all non-major dependencies",
            "groupSlug": "all-non-major"
        },
        {
            "description": "Group stable minor updates; 0.x minors may break and stay separate",
            "matchUpdateTypes": [
                "minor"
            ],
            "matchCurrentVersion": "!/^0/",
            "groupName": "all non-major dependencies",
            "groupSlug": "all-non-major"
        }
    ]
}
